rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.token.email)).data.role in ['owner', 'reviewer'];
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.token.email))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.token.email)).data.role == 'owner';
    }

    // Allowlist is keyed by normalized email. Only an owner can manage it;
    // each authenticated user can check only their own access record.
    match /adminUsers/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt', 'createdByUid', 'createdByEmail'])
        && request.resource.data.keys().hasAll(['email', 'role', 'createdAt', 'createdByUid'])
        && request.resource.data.email == email
        && request.resource.data.role in ['owner', 'reviewer']
        && (email != request.auth.token.email
          || request.resource.data.role == 'owner')
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if isOwner() && email != request.auth.token.email;
    }

    // Apps Script writes pending submissions through the Firestore REST API.
    // Browsers can only review a still-pending record as an approved/rejected
    // decision; submitted profile content and the private email cannot be edited.
    match /teamSubmissions/{submissionId} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
    }

    // Browser admins can append a server-timestamped review record. Entries
    // cannot be changed or deleted after creation.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'action', 'actorUid', 'actorEmail', 'targetId', 'targetName',
          'before', 'after', 'occurredAt', 'durationSeconds'
        ])
        && request.resource.data.keys().hasAll(['action', 'actorUid', 'occurredAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in [
          'profile_approved', 'profile_rejected', 'admin_signed_in', 'admin_signed_out',
          'admin_user_added', 'admin_user_removed'
        ]
        && request.resource.data.occurredAt == request.time
        && (!('durationSeconds' in request.resource.data)
          || (request.resource.data.durationSeconds is int
            && request.resource.data.durationSeconds >= 0
            && request.resource.data.durationSeconds <= 86400));
      allow update, delete: if false;
    }
    match /adminSessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Public website reads approved profiles only. Publishing is admin-only.
    match /teamMembers/{memberId} {
      allow read: if resource.data.isPublished == true;
      allow create, update, delete: if isAdmin();
    }

    match /applications/{applicationId} {
      // Public applications are intentionally create-only. Enable App Check
      // enforcement in Firebase Console to reject unverified client requests.
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'regNumber', 'githubOrPortfolio',
          'guildInterest', 'aboutYou', 'createdAt', 'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'regNumber', 'githubOrPortfolio',
          'guildInterest', 'aboutYou', 'createdAt', 'timestamp'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.regNumber is string
        && request.resource.data.regNumber.size() > 0
        && request.resource.data.regNumber.size() <= 40
        && request.resource.data.githubOrPortfolio is string
        && request.resource.data.githubOrPortfolio.size() > 0
        && request.resource.data.githubOrPortfolio.size() <= 2048
        && request.resource.data.aboutYou is string
        && request.resource.data.aboutYou.size() <= 2000
        && request.resource.data.guildInterest in [
          'Software', 'Hardware', 'Design & Creative', 'Ecosystem & Growth'
        ]
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40;

      allow read, update, delete: if false;
    }
  }
}
