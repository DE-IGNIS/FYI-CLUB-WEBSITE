rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role in ['owner', 'reviewer'];
    }

    // Admin accounts are provisioned manually in Firebase Console. Users can
    // read their own role, but no client can grant or change admin permissions.
    match /adminUsers/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    // Form automation uses trusted server credentials to create pending records.
    // Only registered reviewers can inspect or change their review state.
    match /teamSubmissions/{submissionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Audit history and session records are append/update-only from trusted
    // Cloud Functions (Admin SDK). Browsers can inspect but never alter them.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /adminSessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Public website reads approved profiles only. Publishing is admin-only.
    match /teamMembers/{memberId} {
      allow read: if resource.data.isPublished == true;
      allow create, update, delete: if isAdmin();
    }

    match /applications/{applicationId} {
      // Public applications are intentionally create-only. Enable App Check
      // enforcement in Firebase Console to reject unverified client requests.
      allow create: if request.resource.data.keys().hasAll([
          'name', 'email', 'regNumber', 'githubOrPortfolio',
          'guildInterest', 'aboutYou', 'createdAt', 'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'regNumber', 'githubOrPortfolio',
          'guildInterest', 'aboutYou', 'createdAt', 'timestamp'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && request.resource.data.regNumber is string
        && request.resource.data.regNumber.size() > 0
        && request.resource.data.regNumber.size() <= 40
        && request.resource.data.githubOrPortfolio is string
        && request.resource.data.githubOrPortfolio.size() > 0
        && request.resource.data.githubOrPortfolio.size() <= 2048
        && request.resource.data.aboutYou is string
        && request.resource.data.aboutYou.size() <= 2000
        && request.resource.data.guildInterest in [
          'Software', 'Hardware', 'Design & Creative', 'Ecosystem & Growth'
        ]
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && request.resource.data.timestamp is string
        && request.resource.data.timestamp.size() <= 40;

      allow read, update, delete: if false;
    }
  }
}
